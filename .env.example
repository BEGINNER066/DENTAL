# Supabase Configuration (Optional for local demo mode, required for production cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only keys (NEVER expose to browser/client code)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GIFT_ADMIN_PASSCODE=your-gift-admin-passcode
